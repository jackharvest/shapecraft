<?xml version="1.0" encoding="utf-8"?>
<!-- ShapeCraft for Android: a NativeActivity running libshapecraft.so (apps/shapecraft-android). The little Java
     there is (packaging/android/java) adds the system file picker to that activity and shows the projects folder in
     the Files app (#7). `cargo xtask android-apk` fills in PACKAGE, compiles the Java and links this with aapt2;
     versions and SDK levels come from there. @integer/orientation is written there too: sensorLandscape on phones,
     free from 600 dp (tablets, foldables). -->
<manifest xmlns:android="http://schemas.android.com/apk/res/android" package="PACKAGE">
    <uses-feature android:glEsVersion="0x00030000" android:required="true" />
    <application
        android:label="ShapeCraft"
        android:icon="@mipmap/ic_launcher"
        android:hasCode="true"
        android:extractNativeLibs="false"
        android:allowBackup="false"
        android:appCategory="productivity"
        android:theme="@android:style/Theme.DeviceDefault.NoActionBar.Fullscreen">
        <activity
            android:name="PACKAGE.ShapeCraftActivity"
            android:exported="true"
            android:launchMode="singleTask"
            android:resizeableActivity="true"
            android:screenOrientation="@integer/orientation"
            android:windowSoftInputMode="adjustResize"
            android:configChanges="orientation|screenSize|screenLayout|smallestScreenSize|keyboard|keyboardHidden|navigation|uiMode|density|fontScale">
            <meta-data android:name="android.app.lib_name" android:value="shapecraft" />
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>
        <!-- The projects folder as a place in Files and every file picker; only the system's picker can bind it. -->
        <provider
            android:name="PACKAGE.ProjectsProvider"
            android:authorities="PACKAGE.documents"
            android:grantUriPermissions="true"
            android:exported="true"
            android:permission="android.permission.MANAGE_DOCUMENTS">
            <intent-filter>
                <action android:name="android.content.action.DOCUMENTS_PROVIDER" />
            </intent-filter>
        </provider>
    </application>
</manifest>
