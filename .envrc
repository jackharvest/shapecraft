# Keep direnv/nix-direnv state out of the tree, under
# ~/.cache/direnv/layouts/<hash-of-path>/, so there is nothing to gitignore.
# `direnv prune` cleans stale ones.
direnv_layout_dir="${XDG_CACHE_HOME:-$HOME/.cache}/direnv/layouts/$(printf %s "$PWD" | sha1sum | cut -c1-40)"

use flake
# flake.nix reads the toolchain pin at eval time, so a changed pin reloads the shell.
watch_file rust-toolchain.toml
