{"task": {"category": "drawings", "about": "A projected view to the right of the front view"}}
{"size": [1840, 1324]}
{"control": "project.new", "params": {}}
{"control": "engine.execute", "params": {"command": "sketch", "params": {"plane": "xy"}}}
{"control": "engine.execute", "params": {"command": "rectangle", "params": {"corner": [0, 0], "opposite": [20, 10]}}}
{"control": "engine.execute", "params": {"command": "extrude", "params": {"sketch": 1, "region": 0, "distance": 10}}}
{"control": "engine.execute", "params": {"command": "deselect_all", "params": {}}}
{"control": "engine.execute", "params": {"command": "create_drawing", "params": {"bodies": [2]}}, "save": {"name": "dr", "at": "/drawing"}}
{"control": "engine.execute", "params": {"command": "add_drawing_view", "params": {"drawing": "$dr", "kind": "base", "orientation": "front", "at": [120, 180]}}, "save": {"name": "v", "at": "/view"}}
{"control": "engine.execute", "params": {"command": "add_drawing_view", "params": {"drawing": "$dr", "kind": "projected", "parent": "$v", "dx": 1, "dy": 0, "at": [260, 180]}}}
{"control": "engine.execute", "params": {"command": "export_drawing", "params": {"drawing": "$dr", "path": "$TMP/p.svg"}}}
{"expect": {"file": "$TMP/p.svg"}}
