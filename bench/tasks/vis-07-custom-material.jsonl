{"task": {"category": "visualization", "about": "A custom material from a picture, on a body"}}
{"size": [1840, 1324]}
{"control": "project.new", "params": {}}
{"control": "engine.execute", "params": {"command": "sketch", "params": {"plane": "xy"}}}
{"control": "engine.execute", "params": {"command": "rectangle", "params": {"corner": [0, 0], "opposite": [20, 10]}}}
{"control": "engine.execute", "params": {"command": "extrude", "params": {"sketch": 1, "region": 0, "distance": 10}}}
{"control": "engine.execute", "params": {"command": "deselect_all", "params": {}}}
{"control": "ui.capture", "params": {"path": "$TMP/wood.png"}}
{"control": "engine.execute", "params": {"command": "import_material", "params": {"path": "$TMP/wood.png"}}, "save": {"name": "m", "at": "/image"}}
{"control": "engine.execute", "params": {"command": "set_appearance", "params": {"items": [2], "custom": "$m"}}}
{"control": "engine.execute", "params": {"command": "inspect"}, "returns": {"at": "/bodies/0/appearance/texture", "is": "$m"}}
