<?xml version="1.0" encoding="utf-8"?>
<!-- IIS settings for the static ShapeCraft page: index.html first, media cached for a week. -->
<configuration>
  <system.webServer>
    <defaultDocument enabled="true">
      <files>
        <clear />
        <add value="index.html" />
      </files>
    </defaultDocument>
    <staticContent>
      <clientCache cacheControlMode="UseMaxAge" cacheControlMaxAge="7.00:00:00" />
    </staticContent>
  </system.webServer>
  <location path="index.html">
    <system.webServer>
      <staticContent>
        <clientCache cacheControlMode="UseMaxAge" cacheControlMaxAge="0.00:05:00" />
      </staticContent>
    </system.webServer>
  </location>
</configuration>
